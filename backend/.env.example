# Django/MySQL variables for the backend. These are read from the repo
# ROOT .env file (backend/config/settings.py loads ../.env), so just add
# these keys alongside the existing LLM_* / OPENAI_API_KEY vars there —
# this file only documents what's expected.

# ── Django ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── MySQL ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults; override if pointing at a different DB.
MYSQL_DATABASE=llm_engine
MYSQL_USER=llm_engine
MYSQL_PASSWORD=llm_engine
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this API (the React frontend).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Auth (Supabase) ──────────────────────────────────────────────────────
# Login/registration happen on the frontend via supabase-js; Django only
# verifies the JWT Supabase issues, against this project's JWKS endpoint
# (no shared secret needed — session tokens are signed with an asymmetric
# key). Get this from your Supabase project: Project Settings > API >
# Project URL.
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Only needed to run backend/demo_api.sh, which logs in for real instead of
# faking a token (see that script). Not read by Django itself.
# SUPABASE_ANON_KEY: Project Settings > API > anon public key (safe to share).
# SUPABASE_DEMO_EMAIL / _PASSWORD: a Supabase test user (Auth > Users > Add
# user, with "Auto Confirm User" checked).
SUPABASE_ANON_KEY=<your-project-anon-key>
SUPABASE_DEMO_EMAIL=<test-user-email>
SUPABASE_DEMO_PASSWORD=<test-user-password>
