# Django/MySQL variables for the backend. These are read from the repo
# ROOT .env file (backend/config/settings.py loads ../.env), so just add
# these keys alongside the existing LLM_* / OPENAI_API_KEY vars there —
# this file only documents what's expected.

# ── Django ───────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── MySQL ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults; override if pointing at a different DB.
MYSQL_DATABASE=llm_engine
MYSQL_USER=llm_engine
MYSQL_PASSWORD=llm_engine
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this API (the React frontend).
CORS_ALLOWED_ORIGINS=http://localhost:3000
