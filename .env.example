# ── API keys ─────────────────────────────────────────────────────────────
# Set the key for whichever provider your model strings use.
# OpenAI models ("openai/gpt-4o-mini"):
OPENAI_API_KEY=sk-your-key-here
# OpenRouter models ("openrouter/<vendor>/<model>", e.g.
# "openrouter/anthropic/claude-sonnet-4-5"):
#OPENROUTER_API_KEY=sk-or-your-key-here

# ── Models ───────────────────────────────────────────────────────────────
# Default model for every pipeline task (LiteLLM model string).
LLM_MODEL_DEFAULT=openai/gpt-4o-mini
# Optional per-task overrides. Bump assessment/roadmap to a stronger model
# for demos where question quality is judged.
#LLM_MODEL_SYLLABUS=openai/gpt-4o
#LLM_MODEL_ASSESSMENT=openai/gpt-4o
#LLM_MODEL_GRADING=openai/gpt-4o-mini
#LLM_MODEL_ROADMAP=openrouter/anthropic/claude-sonnet-4-5

# Comma-separated fallback models tried if the primary model errors.
#LLM_FALLBACK_MODELS=openai/gpt-4o,openrouter/anthropic/claude-sonnet-4-5

# ── Sampling temperatures (defaults shown) ───────────────────────────────
# Low temp for consistency (syllabus, grading); higher for variety
# (assessment, roadmap).
#LLM_TEMPERATURE_SYLLABUS=0.2
#LLM_TEMPERATURE_ASSESSMENT=0.6
#LLM_TEMPERATURE_GRADING=0.2
#LLM_TEMPERATURE_ROADMAP=0.6

# ── Reliability ──────────────────────────────────────────────────────────
# Per-call timeout in seconds and LiteLLM transient-error retry count.
#LLM_TIMEOUT_SECONDS=60
#LLM_NUM_RETRIES=2

# ── Proficiency thresholds (percent) ─────────────────────────────────────
# score < PROFICIENCY_WEAK_BELOW            -> "weak"
# WEAK_BELOW <= score < PROFICIENT_AT       -> "developing"
# score >= PROFICIENCY_PROFICIENT_AT        -> "proficient"
#PROFICIENCY_WEAK_BELOW=50
#PROFICIENCY_PROFICIENT_AT=80

# ── Tests ────────────────────────────────────────────────────────────────
# Set to 1 to enable the live end-to-end smoke test (burns real tokens).
#RUN_LIVE_LLM_TESTS=1
